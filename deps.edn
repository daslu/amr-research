{:deps {org.scicloj/noj {:mvn/version "2-beta19.1"}
        org.scicloj/clay {:mvn/version "2.0.0"}
        org.scicloj/scicloj.ml.smile {:mvn/version "7.5.3"}
        org.clojure/tools.logging {:mvn/version "1.3.0"}
        ch.qos.logback/logback-classic {:mvn/version "1.4.14"}
        com.github.psambit9791/jdsp {:mvn/version "3.1.0"}}
 :aliases {:nREPL {:extra-deps
                   {nrepl/nrepl {:mvn/version "1.3.1"}}}
           :nrepl-for-mcp {:extra-paths ["test"]
                           :extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
	                   ;; this allows nrepl to interrupt runaway repl evals
                           :jvm-opts ["-Djdk.attach.allowAttachSelf"]
                           :main-opts ["-m" "nrepl.cmdline" "--port" "7100"]}
           :test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/url "https://github.com/cognitect-labs/test-runner"
                                :git/sha "9e35c979860c75555adaff7600070c60004a0f44"}}
                  :main-opts ["-m" "cognitect.test-runner"
                              "-d" "test"]}
           :test-r-comparison {:extra-paths ["test"]
                               :extra-deps {io.github.cognitect-labs/test-runner
                                            {:git/url "https://github.com/cognitect-labs/test-runner"
                                             :git/sha "9e35c979860c75555adaff7600070c60004a0f44"}}
                               :main-opts ["-m" "cognitect.test-runner"
                                           "-d" "test"
                                           "-n" "maldi.data.r-comparison-test"]}}
 :jvm-opts ["-Xmx28g"]
 :paths ["src" "notebooks"]}


